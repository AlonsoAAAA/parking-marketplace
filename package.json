{
  "name": "parking-marketplace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:marketplace": "pnpm --filter marketplace dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:marketplace\" \"pnpm dev:admin\"",
    "build": "pnpm --filter api build && pnpm --filter marketplace build && pnpm --filter admin build",
    "db:migrate": "pnpm --filter api migration:run",
    "db:seed": "pnpm --filter api seed:run"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "esbuild", "@swc/core", "bcrypt"]
  }
}
