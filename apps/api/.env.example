# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
MARKETPLACE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# URL pública de esta API — usada para el link de la imagen del QR en el boleto,
# el status callback de Twilio, y la verificación de firma del webhook.
# En local: un túnel de ngrok. En producción: la URL real del servicio.
PUBLIC_API_URL=

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://parking_user:parking_pass@localhost:5432/parking_db
REDIS_URL=redis://localhost:6379

# ─── JWT y QR ─────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secret_en_produccion_min_32_chars
QR_SECRET=otro_secret_diferente_para_qr_min_32_chars
# Vigencia del token de sesión (default 7d si no se define)
JWT_EXPIRES_IN=7d

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Obtener webhook secret: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe

# ─── WhatsApp + SMS (Twilio) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sender de WhatsApp — formato legacy mexicano (521 con el '1' extra).
TWILIO_WHATSAPP_NUMBER=whatsapp:+521XXXXXXXXXX
# Número con capacidad SMS — puede ser distinto al de WhatsApp. Se usa como
# fallback automático cuando el envío por WhatsApp falla (número sin WhatsApp,
# sender caído, etc.).
TWILIO_SMS_NUMBER=+1XXXXXXXXXX
# Content Template SIDs aprobados (Twilio Content Template Builder). Sin ellos,
# todos los envíos caen a texto libre — válido solo dentro de la ventana de 24h
# de conversación abierta para WhatsApp (SMS no tiene esta restricción).
TWILIO_OTP_CONTENT_SID=
TWILIO_TICKET_CONTENT_SID=
TWILIO_WELCOME_CONTENT_SID=
TWILIO_REMINDER_24H_CONTENT_SID=
TWILIO_REMINDER_3H_CONTENT_SID=
