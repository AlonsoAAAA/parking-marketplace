# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
MARKETPLACE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://parking_user:parking_pass@localhost:5432/parking_db
REDIS_URL=redis://localhost:6379

# ─── JWT y QR ─────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secret_en_produccion_min_32_chars
QR_SECRET=otro_secret_diferente_para_qr_min_32_chars
# Vigencia del token de sesión (default 7d si no se define)
JWT_EXPIRES_IN=7d

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Obtener webhook secret: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe

# ─── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# SMS — canal temporal para el OTP mientras Meta valida el WABA de WhatsApp
# Business. Número de Twilio con capacidad SMS (NO el sender de WhatsApp).
# No requiere templates aprobados.
TWILIO_SMS_FROM_NUMBER=+1...

# WhatsApp — usado hoy solo para la confirmación de compra (con el link del
# boleto), no para el OTP.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Número de sandbox de Twilio para desarrollo: +14155238886
# En producción: número WABA aprobado (whatsapp:+52...)
# Content SID de la plantilla aprobada por Meta. Sin ella → texto libre (solo sandbox).
TWILIO_TICKET_TEMPLATE_SID=HX...
